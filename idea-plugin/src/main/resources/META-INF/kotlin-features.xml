<idea-plugin>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <intentionAction>
            <language>kotlin</language>
            <className>io.github.translationshub.idea.kotlin.ExtractStringIntention</className>
            <category>KMP Translations Hub</category>
        </intentionAction>
        <localInspection language="kotlin" shortName="HardcodedComposeText" displayName="Hardcoded text in Compose UI"
                         groupName="KMP Translations Hub" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="io.github.translationshub.idea.kotlin.HardcodedComposeTextInspection"/>
    </extensions>
</idea-plugin>
